{
    "name": "openeuropa/oe_content_extra",
    "description": "OpenEuropa Drupal module that adds additional fields and structure to content types from oe_content.",
    "type": "drupal-module",
    "license": "EUPL-1.2",
    "minimum-stability": "dev",
    "prefer-stable": true,
    "require": {
        "php": ">=8.1",
        "drupal/core": "^10 || ^11"
    },
    "require-dev": {
        "composer/installers": "^2.0",
        "drupal/address": "^1.10 || ^2.0",
        "drupal/composite_reference": "^2.1",
        "drupal/config_devel": "^1.9",
        "drupal/core-composer-scaffold": "^10 || ^11",
        "drupal/core-dev": "^10 || ^11",
        "drupal/description_list_field": "^1.0.0-alpha5",
        "drupal/entity_browser": "~2.13.0",
        "drupal/entity_reference_revisions": "^1.9",
        "drupal/field_group": "^3.2",
        "drupal/typed_link": "^2.0.1",
        "drush/drush": "^12.4 || ^13",
        "openeuropa/code-review-drupal": "^1.0.0-alpha",
        "openeuropa/oe_content": "^4.8",
        "openeuropa/task-runner-drupal-project-symlink": "^1.0"
    },
    "scripts": {
        "post-install-cmd": "./vendor/bin/run drupal:site-setup",
        "post-update-cmd": "./vendor/bin/run drupal:site-setup"
    },
    "repositories": [
        {
            "type": "composer",
            "url": "https://packages.drupal.org/8"
        }
    ],
    "autoload": {
        "psr-4": {
            "Drupal\\oe_content_extra\\": "./src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Drupal\\Tests\\oe_content_extra\\": "./tests/src"
        }
    },
    "extra": {
        "composer-exit-on-patch-failure": true,
        "enable-patching": true,
        "patches-ignore": {
            "openeuropa/oe_content": {
                "drupal/field_group": {
                    "https://www.drupal.org/project/field_group/issues/2787179": "https://www.drupal.org/files/issues/2023-04-07/2787179-highlight-html5-validation-85.patch"
                }
            }
        },
        "installer-paths": {
            "build/core": ["type:drupal-core"],
            "build/profiles/contrib/{$name}": ["type:drupal-profile"],
            "build/modules/contrib/{$name}": ["type:drupal-module"],
            "build/themes/contrib/{$name}": ["type:drupal-theme"]
        },
        "drupal-scaffold": {
            "locations": {
                "web-root": "./build"
            }
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "composer/installers": true,
            "cweagans/composer-patches": true,
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "drupal/core-composer-scaffold": true,
            "php-http/discovery": false,
            "phpro/grumphp-shim": true,
            "phpstan/extension-installer": true,
            "tbachert/spi": false
        }
    }
}
